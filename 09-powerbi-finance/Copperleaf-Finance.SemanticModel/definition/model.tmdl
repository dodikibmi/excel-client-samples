model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "Norm", "Money", "Checking_Clean", "Savings_Clean", "Card_Clean", "Rules", "AccountsRaw", "Adjustments", "BankLines", "CashPlanCalc", "_Measures", "Ledger", "Account", "Category", "Date", "Budget", "Statements", "Source Files", "Checks", "Cash Plan", "Forecast", "Forecast Week", "Cash Buffer", "Insights"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table Ledger
ref table Account
ref table Category
ref table Date
ref table Budget
ref table Statements
ref table 'Source Files'
ref table Checks
ref table 'Cash Plan'
ref table Forecast
ref table 'Forecast Week'
ref table 'Cash Buffer'
ref table Insights

