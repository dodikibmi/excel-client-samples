/// What-if values for the minimum cash buffer.
table 'Cash Buffer'
	lineageTag: f1b57574-300c-53c8-8fe3-6863a7f14a81

	column 'Cash Buffer'
		dataType: int64
		formatString: #,0
		lineageTag: 6b7baa24-0dd8-5c5b-95aa-a57a8626ba53
		summarizeBy: none
		sourceColumn: Cash Buffer

		annotation SummarizationSetBy = Automatic

	partition 'Cash Buffer' = m
		mode: import
		source =
				let
				    // what-if: the minimum cash the owner wants to keep (picked in a slicer, 10,000 when nothing is picked)
				    Source = Table.FromList(List.Numbers(0, 13, 2500), Splitter.SplitByNothing(), type table [#"Cash Buffer" = Int64.Type])
				in
				    Source

	annotation PBI_ResultType = Table
