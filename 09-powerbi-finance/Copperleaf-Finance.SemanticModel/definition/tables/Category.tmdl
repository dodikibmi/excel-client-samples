/// Groups accounts into the lines of the P&L and balance sheet.
table Category
	lineageTag: affabfcb-1711-5eb2-93cd-025777c0f983

	column 'Category Key'
		dataType: string
		isKey
		lineageTag: 08fa3315-4d90-5702-a9a6-654436ec6a21
		summarizeBy: none
		sourceColumn: Category Key

		annotation SummarizationSetBy = Automatic

	column Category
		dataType: string
		sortByColumn: Sort
		lineageTag: 2f2b6973-ec96-5516-861a-e25984dfc7a6
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column Group
		dataType: string
		lineageTag: 6a3c819d-2df6-5298-9753-46f91188591b
